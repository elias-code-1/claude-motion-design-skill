{
  "name": "motion-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "sfx": "python3 scripts/gen_audio.py",
    "vo": "node scripts/generate-vo.mjs",
    "render": "remotion render Film out/video.mp4 --codec=h264 --crf=16",
    "render:vertical": "remotion render FilmVertical out/video-vertical.mp4 --codec=h264 --crf=16",
    "still": "remotion still Film out/poster.png --frame=60",
    "stills": "node scripts/stills.mjs 30 120 220 300",
    "typecheck": "tsc --noEmit"
  }
}
